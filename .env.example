# Environment Variables Template
# Copy this file to .env.local and fill in your values.
# With no .env.local the site still builds: the resume falls back to sample data.

# ============================================
# Notion (resume page only)
# ============================================
# Your Notion integration token (starts with "ntn_")
NOTION_TOKEN=

# Your Notion resume page ID (32-character hex string)
NOTION_RESUME_PAGE_ID=your_resume_page_id_32_characters

# Blog posts, projects and resources are NOT read from Notion any more: they live in
# data/posts/*.md, data/projects.json and data/resources.json and are edited from /admin.
# The three IDs below are only read by the one-off scripts in scripts/ (import-notion-posts,
# migrate-notion-collections, localize-collection-images); leave them blank otherwise.
NOTION_DATABASE_ID=
NOTION_RESOURCES_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=

# ============================================
# OPTIONAL - Google Analytics 4
# ============================================
# Your GA4 Measurement ID (starts with "G-")
NEXT_PUBLIC_GA_ID=G-

# ============================================
# OPTIONAL - Admin panel + hosted services
# ============================================
# All of these have working defaults baked into the code; set them only to point
# a local build at something other than production. Production values are set as build
# variables on the Cloudflare Pages project (not in GitHub Secrets).

# Admin auth Worker (app/admin, app/artifacts). Defaults to http://localhost:8787
NEXT_PUBLIC_WORKER_URL=

# Artifact + AI library service. Defaults to https://artifacts.mncoleman.com
NEXT_PUBLIC_ARTIFACTS_API_URL=

# Set to 1 to skip the Dark Veil WebGL background (what `npm run dev:lite` does)
NEXT_PUBLIC_DISABLE_DARKVEIL=

# ============================================
# OPTIONAL - Build stamp (scripts/generate-build-info.ts)
# ============================================
# Claims the CalVer deployment number (YYYY.MM.DD.N) from the admin Worker. Must equal the
# Worker's BUILD_TOKEN secret. Unset locally, the number is 0.
BUILD_TOKEN=
# Defaults to NEXT_PUBLIC_WORKER_URL
BUILD_COUNTER_URL=
# Lifts the GitHub API rate limit for the commit-history fallback in shallow clones
GITHUB_TOKEN=
