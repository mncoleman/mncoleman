# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED - Notion CMS Integration
# ============================================
# See NOTION_SETUP.md for detailed instructions

# Your Notion integration token (starts with "ntn_")
NOTION_TOKEN=

# Your Notion blog database ID (32-character hex string)
NOTION_DATABASE_ID=your_blog_database_id_32_characters

# Your Notion resources database ID (32-character hex string)
NOTION_RESOURCES_DATABASE_ID=your_resources_database_id_32_chars

# Your Notion resume page ID (32-character hex string)
NOTION_RESUME_PAGE_ID=your_resume_page_id_32_characters

# Your Notion projects database ID (32-character hex string)
NOTION_PROJECTS_DATABASE_ID=your_projects_database_id_32_chars

# ============================================
# OPTIONAL - Google Analytics 4
# ============================================
# See GOOGLE_ANALYTICS_SETUP.md for detailed instructions

# Your GA4 Measurement ID (starts with "G-")
NEXT_PUBLIC_GA_ID=G-

# ============================================
# OPTIONAL - Admin panel + hosted services
# ============================================
# All of these have working defaults baked into the code; set them only to point
# a local build at something other than production. They are also GitHub Secrets
# (see .github/workflows/deploy.yml) so the deployed build gets the real values.

# Admin auth Worker (app/admin, app/artifacts). Defaults to http://localhost:8787
NEXT_PUBLIC_WORKER_URL=

# Telegram bot backing the admin login widget
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# Artifact + "A"I library service. Defaults to https://artifacts.mncoleman.com
NEXT_PUBLIC_ARTIFACTS_API_URL=

# Visitor-globe guestbook API. Falls back to NEXT_PUBLIC_ARTIFACTS_API_URL
NEXT_PUBLIC_VISITOR_API_URL=

# Set to 1 to skip the Dark Veil WebGL background (what `npm run dev:lite` does)
NEXT_PUBLIC_DISABLE_DARKVEIL=
