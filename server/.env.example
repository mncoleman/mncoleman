# Public base URL the service is reachable at
PUBLIC_BASE_URL=https://artifacts.mncoleman.com

# Where artifact files are stored on disk (inside the container)
STORAGE_ROOT=/data

# HTTP listen port
PORT=7878

# Shared secret for JWT verification (HS256). Must match the Cloudflare Worker.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# CORS allowlist — comma-separated origins that may call /api/list
CORS_ORIGINS=https://mncoleman.com,https://mncoleman.github.io,http://localhost:3000

# Max upload size in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400
